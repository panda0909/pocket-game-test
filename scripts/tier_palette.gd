class_name TierPalette
extends RefCounted

## 階級顏色的唯一來源。守衛方形角標、投射物、合成特效、傷害數字都取自這裡，
## 放在一處才不會出現「同一階在不同地方顏色不一樣」。
##
## 十二階的配色刻意走「冷 → 暖 → 螢光 → 熔岩」的升溫路線，讓玩家不必
## 讀數字也感覺得出強弱。每個顏色都要在米白背景上看得見，
## 所以沒有白色或極淺色。

const COLORS := [
	Color(0.62, 0.66, 0.72),  #  1 灰
	Color(0.40, 0.74, 0.52),  #  2 綠
	Color(0.30, 0.62, 0.88),  #  3 藍
	Color(0.62, 0.44, 0.88),  #  4 紫
	Color(0.94, 0.62, 0.24),  #  5 橘
	Color(0.92, 0.28, 0.34),  #  6 紅
	Color(0.98, 0.78, 0.12),  #  7 金
	Color(0.10, 0.78, 0.80),  #  8 青
	Color(0.94, 0.30, 0.74),  #  9 洋紅
	Color(0.48, 0.86, 0.20),  # 10 螢光綠
	Color(0.32, 0.28, 0.92),  # 11 靛
	Color(1.00, 0.32, 0.06),  # 12 熔岩
]


static func color_for(tier: int) -> Color:
	return COLORS[clampi(tier, 1, COLORS.size()) - 1]
